{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proline-roofing",
  "main": "workers/site.ts",
  "compatibility_date": "2026-05-26",
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "prolineroofingandsolar.co.uk", "custom_domain": true },
    { "pattern": "www.prolineroofingandsolar.co.uk", "custom_domain": true }
  ]
}
